{
  "openapi": "3.1.0",
  "info": {
    "title": "ECDAT Backend API (Module M7)",
    "description": "Enterprise Cryptographic Discovery & Analysis Tool (ECDAT) Backend API.\nCoordinates discovery scanning, Mosca quantum risk assessment, PQC recommendations, and CycloneDX 1.6 Cryptography Bill of Materials (CBOM) export.",
    "version": "1.0.0"
  },
  "paths": {
    "/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Create Scan",
        "description": "Kicks off an asynchronous cryptographic discovery scan.\nReturns immediately with a scanId and 'queued' status.",
        "operationId": "create_scan_scans_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "List Scans",
        "description": "Lists recent scans.",
        "operationId": "list_scans_scans_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanResponse"
                  },
                  "title": "Response List Scans Scans Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scans/{scan_id}": {
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Get Scan",
        "description": "Polls the status of an ongoing or completed scan.",
        "operationId": "get_scan_scans__scan_id__get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List Assets",
        "description": "Returns paginated assets matching filter criteria.\nIf 'z' query parameter is provided, recomputes Mosca r = (X+Y)/Z and risk tier dynamically!",
        "operationId": "list_assets_assets_get",
        "parameters": [
          {
            "name": "scanId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by scan job ID",
              "title": "Scanid"
            },
            "description": "Filter by scan job ID"
          },
          {
            "name": "riskTier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by risk tier (Critical, High, Medium, Low)",
              "title": "Risktier"
            },
            "description": "Filter by risk tier (Critical, High, Medium, Low)"
          },
          {
            "name": "exposure",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by exposure (external-facing, internal-only)",
              "title": "Exposure"
            },
            "description": "Filter by exposure (external-facing, internal-only)"
          },
          {
            "name": "businessCriticality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by business criticality",
              "title": "Businesscriticality"
            },
            "description": "Filter by business criticality"
          },
          {
            "name": "algorithm",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by algorithm name (e.g. SHA-1, RSA-2048)",
              "title": "Algorithm"
            },
            "description": "Filter by algorithm name (e.g. SHA-1, RSA-2048)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Items per page",
              "default": 50,
              "title": "Pagesize"
            },
            "description": "Items per page"
          },
          {
            "name": "z",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 50.0,
                  "minimum": 0.5
                },
                {
                  "type": "null"
                }
              ],
              "description": "Interactive threat-timeline Z slider override",
              "title": "Z"
            },
            "description": "Interactive threat-timeline Z slider override"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{asset_id}": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Get Asset Detail",
        "description": "Returns full asset details including exact file/line, complete Mosca breakdown,\nand side-by-side migration recommendation.",
        "operationId": "get_asset_detail_assets__asset_id__get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cbom/{scan_id}": {
      "get": {
        "tags": [
          "CBOM"
        ],
        "summary": "Download Cbom Json",
        "description": "Returns the standardized CycloneDX 1.6 CBOM document for the specified scan ID.\nDelivered with Content-Disposition: attachment.",
        "operationId": "download_cbom_json_cbom__scan_id__get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{scan_id}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Export Scan Report",
        "description": "Generates and downloads a report for the specified scan.",
        "operationId": "export_scan_report_reports__scan_id__get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "pdf",
                "csv",
                "json"
              ],
              "type": "string",
              "description": "Report format: pdf, csv, or json",
              "default": "json",
              "title": "Format"
            },
            "description": "Report format: pdf, csv, or json"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/config/threat-model": {
      "get": {
        "tags": [
          "Configuration"
        ],
        "summary": "Get Threat Model Config",
        "description": "Returns the current threat model assumptions and risk weights.",
        "operationId": "get_threat_model_config_config_threat_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Configuration"
        ],
        "summary": "Update Threat Model Config",
        "description": "Updates the stored default threat-model config (Z timeline, risk weights).",
        "operationId": "update_threat_model_config_config_threat_model_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreatModelUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlgorithmProperties": {
        "properties": {
          "primitive": {
            "type": "string",
            "title": "Primitive"
          },
          "parameterSetIdentifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parametersetidentifier"
          },
          "executionEnvironment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executionenvironment",
            "default": "software-plain-ram"
          },
          "implementationPlatform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Implementationplatform",
            "default": "generic"
          },
          "cryptoFunctions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cryptofunctions"
          },
          "classicalSecurityLevel": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classicalsecuritylevel"
          },
          "nistQuantumSecurityLevel": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nistquantumsecuritylevel"
          }
        },
        "type": "object",
        "required": [
          "primitive"
        ],
        "title": "AlgorithmProperties"
      },
      "AssetDetailResponse": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/CanonicalCBOMAsset"
          },
