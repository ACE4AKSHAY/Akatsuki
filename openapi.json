          },
          "estimatedShelfLifeYears": {
            "type": "number",
            "title": "Estimatedshelflifeyears"
          },
          "estimatedMigrationEffortYears": {
            "type": "number",
            "title": "Estimatedmigrationeffortyears"
          },
          "moscaX": {
            "type": "number",
            "title": "Moscax"
          },
          "moscaY": {
            "type": "number",
            "title": "Moscay"
          },
          "moscaZ": {
            "type": "number",
            "title": "Moscaz"
          },
          "moscaR": {
            "type": "number",
            "title": "Moscar"
          },
          "moscaRiskTier": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ],
            "title": "Moscarisktier"
          },
          "recommendedReplacement": {
            "type": "string",
            "title": "Recommendedreplacement"
          },
          "referenceStandard": {
            "type": "string",
            "title": "Referencestandard"
          },
          "riskScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
