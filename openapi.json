            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "zUsed": {
            "type": "number",
            "title": "Zused"
          },
          "criticalCount": {
            "type": "integer",
            "title": "Criticalcount"
          },
          "highCount": {
            "type": "integer",
            "title": "Highcount"
          },
          "mediumCount": {
            "type": "integer",
            "title": "Mediumcount"
          },
          "lowCount": {
            "type": "integer",
            "title": "Lowcount"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "pages",
          "zUsed",
          "criticalCount",
          "highCount",
          "mediumCount",
          "lowCount"
        ],
        "title": "AssetSummaryResponse"
      },
      "CanonicalCBOMAsset": {
        "properties": {
          "bom-ref": {
            "type": "string",
            "title": "Bom-Ref"
          },
          "type": {
            "type": "string",
            "title": "Type",
