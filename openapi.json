          "complianceTarget": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NIST-general",
                  "CNSA2.0"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Compliancetarget",
            "default": "NIST-general"
          },
          "threatTimelineOverride": {
            "anyOf": [
              {
                "type": "number"
