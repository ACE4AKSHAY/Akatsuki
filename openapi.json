            "title": "Moscabreakdown"
          },
          "recommendation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Recommendation"
          }
        },
        "type": "object",
        "required": [
          "asset",
          "moscaBreakdown",
          "recommendation"
        ],
        "title": "AssetDetailResponse"
      },
      "AssetSummaryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CanonicalCBOMAsset"
